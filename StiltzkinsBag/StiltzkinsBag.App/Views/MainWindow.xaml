<Window x:Class="StiltzkinsBag.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Stiltzkin's Bag"
        Height="720" Width="1000"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SB.BackgroundBrush}"
        TextElement.Foreground="{StaticResource SB.TextPrimaryBrush}"
        TextElement.FontFamily="{materialDesign:MaterialDesignFont}"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header -->
            <RowDefinition Height="*" />
            <!-- Content -->
            <RowDefinition Height="Auto" />
            <!-- Footer / Generate bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════
             Header
        ════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SB.SurfaceBrush}"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Stiltzkin's Bag"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource SB.AccentBrush}" />
                <TextBlock Text="  —  FFIX Randomizer"
                           FontSize="16"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,2"
                           Foreground="{StaticResource SB.TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════
             Main content area (placeholder)
        ════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="24"
                Background="{StaticResource SB.SurfaceBrush}"
                CornerRadius="4"
                Padding="24">
            <TextBlock Text="Settings panels will be built in Phase 7."
                       Foreground="{StaticResource SB.TextSecondaryBrush}"
                       FontStyle="Italic"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- ═══════════════════════════════════════════
             Footer — seed input + generate button
        ════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SB.SurfaceBrush}"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Seed field -->
                <TextBox Grid.Column="0"
                         Margin="0,0,16,0"
                         materialDesign:HintAssist.Hint="Enter seed..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="{StaticResource SB.TextPrimaryBrush}"
                         IsEnabled="False" />

                <!-- Random seed button -->
                <Button Grid.Column="1"
                        Content="Random Seed"
                        Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        IsEnabled="False" />

                <!-- Generate button — disabled until pipeline is wired -->
                <Button Grid.Column="2"
                        Content="GENERATE"
                        Width="140"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource SB.PrimaryBrush}"
                        IsEnabled="False" />
            </Grid>
        </Border>

    </Grid>
</Window>